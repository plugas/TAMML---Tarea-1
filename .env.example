# ── OpenAI (agente Módulo 2/3) ───────────────────────────────────────────────
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ── Supabase ─────────────────────────────────────────────────────────────────
# JWT anon legacy (eyJ...), NO sb_publishable_
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_KEY=

# PostgreSQL directo (PostgresSaver + memoria por teléfono/session_id)
# Dashboard → Project Settings → Database → Reset password → URI (Session pooler, 5432)
# Formato: postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Si la contraseña tiene @ # % codifícala en URL (%40, %23, %25).
SUPABASE_DB_URL=

# ── API producto (Módulo 3) ──────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CHAT_CHANNEL=whatsapp
# fastapi_webhook (Vía 2 activa) | n8n (Vía 1)
WHATSAPP_INTEGRATION=fastapi_webhook
# true solo en demo Streamlit; false en WhatsApp/N8N (flujo automático)
HITL_INTERRUPT_TOOLS=false

# ── WhatsApp Cloud API (Meta) — Vía 2 webhook en FastAPI (opcional) ─────────
# Si usas solo N8N, puedes dejar vacío.
WHATSAPP_VERIFY_TOKEN=riopaila_verify_token_cambiar
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Enlaces en la web Streamlit (apartado Canales)
WHATSAPP_DEMO_NUMBER=15550598036
WHATSAPP_DEMO_DISPLAY=+1 (555) 059-8036
# Opcional — dejar vacío si Telegram no está configurado aún
TELEGRAM_BOT_URL=
TELEGRAM_BOT_DISPLAY=Riopaila Agente TAMML

# ── Groq (Módulo 1 legacy) ───────────────────────────────────────────────────
GROQ_API_KEY=

# ── LangSmith (opcional) ─────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=riopaila-agent-module3

# ── RAG ──────────────────────────────────────────────────────────────────────
CHUNK_SIZE=1200
RAG_TOP_K=12
