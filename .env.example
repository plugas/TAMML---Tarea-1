# ── Plantilla de variables de entorno — copiar a .env y rellenar ────────────────
# El archivo .env real está en .gitignore (NO se versiona).

# OpenAI (Módulo 2 — Agente RAG / embeddings)
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Supabase (Módulo 2)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_KEY=eyJ...                         # clave anon (Legacy JWT), empieza por eyJ
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Groq (Módulo 1 + fallback de OpenFang en la nube)
GROQ_API_KEY=gsk_...

# LangSmith (observabilidad — Módulo 2)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=TAMLL

# ── Módulo 3 — OpenFang Agent OS ────────────────────────────────────────────────
# Token del bot de Telegram (crear con @BotFather). Lo lee OpenFang.
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
